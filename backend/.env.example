# Copy this file to .env and adjust as needed.
# The app runs fully on local models via Ollama — no API key required.
# Make sure Ollama is running (`ollama serve`) and both models are pulled:
#   ollama pull llama3.2:3b
#   ollama pull nomic-embed-text

OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.5
SMALL_CORPUS_CHUNK_LIMIT=12
HISTORY_TURNS=6

MAX_FILE_SIZE_MB=20
ALLOWED_ORIGINS=http://localhost:5173

# Web search fallback (used only when the "also use general knowledge" toggle is on and
# nothing relevant is found in the uploaded documents). Uses DuckDuckGo — no API key needed.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=5
